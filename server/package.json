{
  "name": "server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Express + TypeScript API for the kids story generator",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "test": "tsx --test test/validation.test.ts test/wav.test.ts test/prompts.test.ts test/api.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@google/genai": "3.6.1",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.23",
    "@types/node": "^24.3.1",
    "@types/supertest": "^6.0.3",
    "supertest": "^7.1.3",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2"
  }
}
